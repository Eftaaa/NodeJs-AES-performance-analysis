<!DOCTYPE html>
<html>
  <head>
    <% var pageTitle='Chestionar online' %>
    <meta charset="utf-8" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" type="text/css" href="../stil.css" />
  </head>

  <body>
    <nav class="nav">
      <ul>
        <li><a href="/" class="active">Demo Page</a></li>
        <li><a href="upload_file">Upload File</a></li>
        <% if (username == null) { %>
        <li><a href="/autentificare">Login</a></li>
        <li><a href="/inregistrare">Sign up</a></li>
        <% } %>
      </ul>
      <% if (username != null) { %>
      <h1>Bine ai venit, <%= username %>!</h1>
      <p>
        Autentificat ca <b><%= username %></b> |
        <a href="/autentificare">Deconectare</a>
      </p>
      <% } %>
    </nav>

    <main>
      <div class="container-cr">
        <div class="header-container">
          <h2>Encryption Methods:</h2>
          <p>AES-GCM Encryption (Program 1)</p>
          <p>OpenSSL AES-GCM Encryption (Program 2)</p>
          <button id="encryptButton">Encrypt Page</button>
        </div>
      </div>

      <div class="site-demo"><%- body %></div>

      <div class="Statistici">
        <h3>Encryption Statistics</h3>
        <div id="encryptionStats"></div>
      </div>
      <script>
        document
          .getElementById("encryptButton")
          .addEventListener("click", function () {
            // Extract the HTML content inside the div with class "site-demo"
            const siteDemoContent =
              document.querySelector(".site-demo").innerHTML;

            // Send the content to the server for encryption
            fetch("/encrypt", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ content: siteDemoContent }),
            })
              .then((response) => {
                if (response.status === 401) {
                  alert("You must be logged in to perform this action.");
                  window.location.href = "/autentificare"; // Redirect to the login page
                } else if (!response.ok) {
                  throw new Error("Error during encryption");
                }
                return response.text();
              })
              .then((data) => {
                console.log("Success:", data);
                // Update the encryption statistics on the page
                fetchEncryptionStats();
              })
              .catch((error) => {
                console.error("Error:", error);
              });
          });

        function fetchEncryptionStats() {
          fetch("/encryption-stats")
            .then((response) => {
              if (!response.ok) {
                throw new Error("Error fetching encryption statistics");
              }
              return response.json();
            })
            .then((data) => {
              const statsDiv = document.getElementById("encryptionStats");
              if (data.length === 0) {
                statsDiv.innerHTML =
                  "<p>No encryption statistics available.</p>";
                return;
              }

              const table = document.createElement("table");
              table.innerHTML = `
                <tr>
                  <th>First Encryption Time (ms)</th>
                  <th>Second Encryption Time (ms)</th>
                  <th>Timestamp</th>
                  <th>Name</th>
                </tr>
              `;

              data.forEach((row) => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                  <td>${row.first_encryption_time}</td>
                  <td>${row.second_encryption_time}</td>
                  <td>${new Date(row.timestamp).toLocaleString()}</td>
                    <td>${row.Name ? row.Name : ""}</td>
                `;
                table.appendChild(tr);
              });

              statsDiv.innerHTML = "";
              statsDiv.appendChild(table);
            })
            .catch((error) => {
              console.error("Error:", error);
            });
        }

        // Fetch encryption statistics when the page loads
        document.addEventListener("DOMContentLoaded", fetchEncryptionStats);
      </script>
    </main>

    <footer>
      <p>&copy; 2023 Eftasiu David.</p>
    </footer>
  </body>
</html>
