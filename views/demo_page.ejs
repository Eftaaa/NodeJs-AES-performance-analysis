<head>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/chestionar">Chestionar</a></li>
      <% if (username !=null && typeof admin !=='undefined' && admin) { %>
        <li><a href="/admin">Admin</a></li>
        <% } %>
    </ul>
  </nav>
</head>

<body>
  <% if (username !=null) { %>
    <a href="/vizualizare-cos" class="button">Vizualizare Cos</a>
    <a href="/vizualizare-comenzi" class="button">Vizualizare Comenzi</a>
    <% } %>
      <div class="button-container">
        <% if (username !=null && typeof admin !=='undefined' && admin) { %>

          <button onclick="loadEncryptedContent('/creare-bd')" id="create-db-btn" class="button">
            Creare BD
          </button>
          <button onclick="loadEncryptedContent('/inserare-bd')" id="load-db-btn" class="button">
            Încarcare BD
          </button>
          <% } %>
      </div>
      <h1>Product List</h1>
      <table>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Price</th>
          <% if (authenticated) { %>
            <th>Cart</th>
            <th>Action</th>
          <% } %>
        </tr>
        <% products.forEach(product => { %>
          <tr>
            <td><%= product.id %></td>
            <td><%= product.nume %></td>
            <td><%= product.pret.toFixed(2) %></td>
            <% if (authenticated) { %>
              <td><%= product.cart_quantity || 0 %></td> 
              <td>
                <% if (product.stoc > 0) { %>
                  <form method="POST" action="/adaugare_cos">
                    <input type="hidden" name="id" value="<%= product.id %>" />
                    <button type="submit">Adaugă în coș</button>
                  </form>
                <% } else { %>
                  <span style="color: red">Produs indisponibil</span>
                <% } %>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </table>
</body>
<script>
  document.querySelectorAll("form[action='/adaugare_cos']").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      try {
        const formObject = Object.fromEntries(formData.entries());
        console.log("Submitting form data:", formObject);
        const plaintext = JSON.stringify(formObject);

        const IV = crypto.getRandomValues(new Uint8Array(12));

        const encoder = new TextEncoder();
        const plaintextBytes = encoder.encode(plaintext);

        // Import the raw key data into a CryptoKey object
        const aesKeyData = await crypto.subtle.importKey(
          "raw", // Raw key format
          aesKey, // Raw key data
          { name: "AES-GCM" }, // AES-GCM encryption algorithm
          false, // The key is not extractable
          ["encrypt", "decrypt"] // Key usage
        );

        // Encrypt the plaintext
        const encryptedDataBuffer = await crypto.subtle.encrypt(
          { name: "AES-GCM", iv: IV },
          aesKeyData,
          plaintextBytes
        );

        // Extract ciphertext and authentication tag from the encrypted buffer
        const encryptedBytes = new Uint8Array(encryptedDataBuffer);
        const ciphertext = encryptedBytes.slice(0, -16); // Ciphertext (everything except the last 16 bytes)
        const tag = encryptedBytes.slice(-16); // Authentication tag (last 16 bytes)

        // Convert ciphertext and tag to Base64
        const ciphertextBase64 = btoa(String.fromCharCode(...ciphertext));
        const tagBase64 = btoa(String.fromCharCode(...tag));
        const ivBase64 = btoa(String.fromCharCode(...IV));

        console.log("Sending encrypted data to server:", {
          encryptedData: ciphertextBase64,
          iv: ivBase64,
          tag: tagBase64,
        });
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            encryptedData: ciphertextBase64,
            iv: ivBase64,
            tag: tagBase64,
          }),
        });

        // Parse the server response
        const { encryptedData, authTag, aad, iv } = await response.json();

        // Decrypt the response
        const decryptedData = await decryptData(
          encryptedData,
          aesKey,
          iv,
          aad,
          authTag
        );
        console.log("Decrypted received data:", decryptedData);

        // Parse decrypted data
        const parsedData = JSON.parse(decryptedData);

        if (parsedData.isRedirect) {
          await loadEncryptedContent(parsedData.url);
          history.pushState(null, "", parsedData.url); // Update browser history
          showFloatingMessage(`Product was added successfully!`, "success");
        } else {
          showFloatingMessage(parsedData.data, "error");
        }
      } catch (error) {
        console.error("Error adding product to cart:", error);

        if (error instanceof SyntaxError) {
          showFloatingMessage(
            "An unexpected error occurred. Please try again.",
            "error"
          );
        } else {
          showFloatingMessage(
            "Failed to process the server response. Please try again.",
            "error"
          );
        }
      }
    });
  });
</script>