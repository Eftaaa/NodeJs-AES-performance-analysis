<head>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/chestionar">Chestionar</a></li>
      <% if (username == null) { %>
        <li><a href="/autentificare">Login</a></li>
      <% } %>
      <% if (username != null && typeof admin !== 'undefined' && admin) { %>
        <li><a href="/admin">Admin</a></li>
      <% } %>
    </ul>
    <% if (username != null) { %>
      <h1>Bine ai venit, <%= username %>!</h1>
      <p>Autentificat ca <b><%= username %></b> | <a href="/autentificare">Deconectare</a></p>
    <% } %>
  </nav>
</head>
<body>
<a href="/vizualizare-cos" class="button">Vizualizare Cos</a>
<div class="button-container">
  <button onclick="window.location.href='/creare-bd'" id="create-db-btn" class="button">Creare BD</button>
  <button onclick="window.location.href='/inserare-bd'"  id="load-db-btn" class="button">Încarcare BD</button>
  
   
  </div>
  <h1>Product List</h1>
  <table>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Price</th>
      <% if (authenticated) { %>
        <th>Action</th>
      <% } %>
    </tr>
    <% products.forEach(product => { %>
      <tr>
        <td><%= product.id %></td>
        <td><%= product.nume %></td>
        <td><%= product.pret %></td>
        <% if (authenticated) { %>
            <td>
              <form method="POST" action="/adaugare_cos">
                <input type="hidden" name="id" value="<%= product.id %>">
                <button type="submit">Adaugă în coș</button>
              </form>
            </td>
          <% } %>
      </tr>
    <% }); %>
  </table>
</body>