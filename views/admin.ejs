<h1>Admin: Gestionare Produse</h1>

<h2>Produse Curente</h2>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nume</th>
      <th>Preț</th>
      <th>Stoc</th>
      <th>Acțiuni</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(product=> { %>
      <tr>
        <td>
          <%= product.id %>
        </td>
        <td>
          <%= product.nume %>
        </td>
        <td>
          <form action="/admin/update-pret" method="POST" class="updatePriceForm">
            <input type="hidden" name="id" value="<%= product.id %>" />
            <input type="number" name="pret" value="<%= product.pret.toFixed(2) %>" step="0.01" min="0" required />
            <button type="submit">Actualizează Preț</button>
          </form>
        </td>
        <td>
          <form action="/admin/update-stoc" method="POST" class="updateStockForm">
            <input type="hidden" name="id" value="<%= product.id %>" />
            <input type="number" name="stoc" value="<%= product.stoc %>" min="0" required />
            <button type="submit">Actualizează Stoc</button>
          </form>
        </td>
        <td>
          <form action="/admin/delete-produs" method="POST" class="deleteProductForm">
            <input type="hidden" name="id" value="<%= product.id %>" />
            <button type="submit">Șterge Produs</button>
          </form>
        </td>
      </tr>
      <% }); %>
  </tbody>
</table>

<h2>Adaugă Produs Nou</h2>
<form action="/admin/adauga-produs" method="POST" class="addProductForm">
  <label for="nume">Nume produs:</label>
  <input type="text" id="nume" name="nume" required /><br />
  <label for="pret">Preț produs:</label>
  <input type="number" id="pret" name="pret" step="0.01" required /><br />
  <label for="stoc">Stoc:</label>
  <input type="number" id="stoc" name="stoc" min="0" required /><br />
  <input type="submit" value="Adaugă produs" />
</form>
<script>
  document.querySelectorAll("form").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);

      try {

        const formObject = Object.fromEntries(formData.entries());
        console.log("Submitting form data:", formObject);
        const plaintext = JSON.stringify(formObject);

        const IV = crypto.getRandomValues(new Uint8Array(12));

        const encoder = new TextEncoder();
        const plaintextBytes = encoder.encode(plaintext);

        // Import the raw key data into a CryptoKey object
        const aesKeyData = await crypto.subtle.importKey(
          "raw", // Raw key format
          aesKey, // Raw key data
          { name: "AES-GCM" }, // AES-GCM encryption algorithm
          false, // The key is not extractable
          ["encrypt", "decrypt"] // Key usage
        );

        const encryptedDataBuffer = await crypto.subtle.encrypt(
          { name: "AES-GCM", iv: IV },
          aesKeyData,
          plaintextBytes
        );

        const encryptedBytes = new Uint8Array(encryptedDataBuffer);
        const ciphertext = encryptedBytes.slice(0, -16);
        const tag = encryptedBytes.slice(-16);


        const ciphertextBase64 = btoa(String.fromCharCode(...ciphertext));
        const tagBase64 = btoa(String.fromCharCode(...tag));
        const ivBase64 = btoa(String.fromCharCode(...IV));

        console.log("Sending encrypted data to server:", {
          encryptedData: ciphertextBase64,
          iv: ivBase64,
          tag: tagBase64,
        });


        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            encryptedData: ciphertextBase64,
            iv: ivBase64,
            tag: tagBase64,
          }),
        });

        if (!response.ok) {
          throw new Error("Form submission failed");
        }

        const { encryptedData, authTag, aad, iv } = await response.json();

        const decryptedData = await decryptData(
          encryptedData,
          aesKey,
          iv,
          aad,
          authTag
        );

        console.log("Decrypted response data:", decryptedData);

        const parsedData = JSON.parse(decryptedData);
        if (parsedData.isRedirect) {
          await loadEncryptedContent(parsedData.url);
        } else {
          await loadEncryptedContent("admin");
          showFloatingMessage(parsedData.message, "success");
        }
      } catch (error) {
        console.error("Error handling form submission:", error);
        showFloatingMessage("An error occurred. Please try again.", "error");
      }
    });
  });
</script>