<form action="/admin/adauga-produs" method="POST">
  <label for="nume">Nume produs:</label>
  <input type="text" id="nume" name="nume" required /><br />
  <label for="pret">Pret produs:</label>
  <input type="number" id="pret" name="pret" step="0.01" required /><br />
  <input type="submit" value="Adaugă produs" />
</form>
<script>
  document
    .querySelectorAll("form[action='/admin/adauga-produs']")
    .forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); // Prevent default form submission

        const formData = new FormData(form);

        try {
          // Convert form data to an object
          const formObject = Object.fromEntries(formData.entries());
          console.log("Submitting form data:", formObject);

          // Send the POST request
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(formObject),
          });

          if (!response.ok) {
            throw new Error("Failed to submit form");
          }

          // Parse the encrypted response
          const { encryptedData, authTag, aad, iv } = await response.json();

          // Decrypt the response
          const decryptedData = await decryptData(
            encryptedData,
            aesKey,
            iv,
            aad,
            authTag
          );

          const parsedData = JSON.parse(decryptedData);

          if (parsedData.isRedirect) {
            // Handle redirect securely
            await loadEncryptedContent(parsedData.url);
            history.pushState(null, "", parsedData.url); // Update browser history
          } else {
            alert("Product added to list successfully!");
          }
        } catch (error) {
          console.error("Error adding product to list:", error);
          alert("Failed to add product to list. Please try again.");
        }
      });
    });
</script>
