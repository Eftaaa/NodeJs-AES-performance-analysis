<h1>Produse în Coș</h1>
<% if (cart.length === 0) { %>
<p>Coșul este gol.</p>
<% } else { %>
<form id="cartForm" action="/update-cart" method="POST">
  <table>
    <tr>
      <th>Produs</th>
      <th>Preț</th>
      <th>Cantitate</th>
      <th>Total</th>
      <th>Acțiune</th>
    </tr>
    <% let totalPrice = 0; %> <% cart.forEach(item => { %> <% const
    productTotalPrice = item.pret * item.quantity; %> <% totalPrice +=
    productTotalPrice; %>
    <tr>
      <td><%= item.nume %></td>
      <td><%= item.pret.toFixed(2) %></td>
      <td>
        
        <input
          type="number"
          name="quantity_<%= item.product_id %>"
          value="<%= item.quantity %>"
          min="1"
          max="<%= item.stoc %>"
        />
      </td>
      <td><%= productTotalPrice.toFixed(2) %></td>
      <td>
        <button
          type="button"
          class="delete-btn"
          data-product-id="<%= item.product_id %>"
        >
          Șterge
        </button>
      </td>
    </tr>
    <% }); %>
    <tr>
      <td>Total</td>
      <td></td>
      <td></td>
      <td><%= totalPrice.toFixed(2) %></td>
    </tr>
  </table>
  <button type="submit">Actualizează Coșul</button>
  <button id="placeOrderBtn" type="button">Plasează comanda</button>
</form>
<% } %>

<script>
  document
    .getElementById("placeOrderBtn")
    .addEventListener("click", async () => {
      try {
        const response = await fetch("/place-order", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        });

        const { encryptedData, authTag, aad, iv } = await response.json();

        // Decrypt and handle the content
        const decryptedData = await decryptData(
          encryptedData,
          aesKey,
          iv,
          aad,
          authTag
        );

        console.log("Decrypted response data:", decryptedData);
        const parsedData = JSON.parse(decryptedData);
        const responseData = JSON.parse(parsedData.data); // Parse the `data` field

        if (responseData.message === "Order placed successfully!") {
          await loadEncryptedContent("vizualizare-comenzi");
          showFloatingMessage(responseData.message, "success");
        } else {
          showFloatingMessage(responseData.message, "error");
        }
      } catch (error) {
        console.error("Error placing order:", error);
        showFloatingMessage(
          "An unexpected error occurred. Please try again.",
          "error"
        );
      }
    });
  document
    .getElementById("cartForm")
    .addEventListener("submit", async function (event) {
      event.preventDefault(); // Prevent the default form submission behavior

      const form = event.target;
      const formData = new FormData(form);

      try {
        // Convert form data to an object
        const formObject = Object.fromEntries(formData.entries());
        console.log("Submitting form data:", formObject);
        const plaintext = JSON.stringify(formObject);

        // Generate a random IV (12 bytes for AES-GCM)
        const IV = crypto.getRandomValues(new Uint8Array(12));

        // Encode the plaintext as a Uint8Array
        const encoder = new TextEncoder();
        const plaintextBytes = encoder.encode(plaintext);

        // Import the raw key data into a CryptoKey object
        const aesKeyData = await crypto.subtle.importKey(
          "raw", // Raw key format
          aesKey, // Raw key data
          { name: "AES-GCM" }, // AES-GCM encryption algorithm
          false, // The key is not extractable
          ["encrypt", "decrypt"] // Key usage
        );

        // Encrypt the plaintext
        const encryptedDataBuffer = await crypto.subtle.encrypt(
          { name: "AES-GCM", iv: IV },
          aesKeyData,
          plaintextBytes
        );

        // Extract ciphertext and authentication tag from the encrypted buffer
        const encryptedBytes = new Uint8Array(encryptedDataBuffer);
        const ciphertext = encryptedBytes.slice(0, -16); // Ciphertext (everything except the last 16 bytes)
        const tag = encryptedBytes.slice(-16); // Authentication tag (last 16 bytes)

        // Convert ciphertext and tag to Base64
        const ciphertextBase64 = btoa(String.fromCharCode(...ciphertext));
        const tagBase64 = btoa(String.fromCharCode(...tag));
        const ivBase64 = btoa(String.fromCharCode(...IV));

        console.log("Sending encrypted data to server:", {
          encryptedData: ciphertextBase64,
          iv: ivBase64,
          tag: tagBase64, // Send tag as Base64
        });

        // Send the encrypted data to the server
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            encryptedData: ciphertextBase64,
            iv: ivBase64,
            tag: tagBase64,
          }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            document.getElementById("errorMessage").textContent =
              "Authentication failed. Please try again.";
            return;
          }
          if (response.status === 500) {
            document.getElementById("errorMessage").textContent =
              "Peste limita stocului";
            return;
          }
          throw new Error("Form submission failed");
        }

        // Parse the encrypted response
        const { encryptedData, authTag, aad, iv } = await response.json();

        // Decrypt and handle the content
        const decryptedData = await decryptData(
          encryptedData,
          aesKey,
          iv,
          aad,
          authTag
        );

        console.log("Decrypted response data:", decryptedData);

        // If it's a redirect, handle it
        const parsedData = JSON.parse(decryptedData);
        if (parsedData.isRedirect) {
          await loadEncryptedContent(parsedData.url);
        } else {
          document.querySelector("#content").innerHTML = parsedData.data;

          // Execute any scripts in the new content
          const scripts = doc.querySelectorAll("script");
          scripts.forEach((script) => {
            const newScript = document.createElement("script");
            newScript.text = script.textContent;
            document.body.appendChild(newScript);
            document.body.removeChild(newScript);
          });
        }
      } catch (error) {
        console.error("Error handling form submission:", error);
        document.getElementById("errorMessage").textContent =
          "An error occurred. Please try again.";
      }
    });

  document.querySelectorAll(".delete-btn").forEach((button) => {
    button.addEventListener("click", async (event) => {
      const productId = event.target.getAttribute("data-product-id");

      try {
        const plaintext = JSON.stringify({ [`delete_${productId}`]: true });

        const IV = crypto.getRandomValues(new Uint8Array(12));

        const encoder = new TextEncoder();
        const plaintextBytes = encoder.encode(plaintext);

        // Import the raw key data into a CryptoKey object
        const aesKeyData = await crypto.subtle.importKey(
          "raw",
          aesKey,
          { name: "AES-GCM" },
          false,
          ["encrypt", "decrypt"]
        );

        const encryptedDataBuffer = await crypto.subtle.encrypt(
          { name: "AES-GCM", iv: IV },
          aesKeyData,
          plaintextBytes
        );

        const encryptedBytes = new Uint8Array(encryptedDataBuffer);
        const ciphertext = encryptedBytes.slice(0, -16);
        const tag = encryptedBytes.slice(-16);

        const ciphertextBase64 = btoa(String.fromCharCode(...ciphertext));
        const tagBase64 = btoa(String.fromCharCode(...tag));
        const ivBase64 = btoa(String.fromCharCode(...IV));

        console.log("Sending encrypted delete request:", {
          encryptedData: ciphertextBase64,
          iv: ivBase64,
          tag: tagBase64,
        });

        const response = await fetch("/update-cart", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            encryptedData: ciphertextBase64,
            iv: ivBase64,
            tag: tagBase64,
          }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            document.getElementById("errorMessage").textContent =
              "Authentication failed. Please try again.";
            return;
          }
          throw new Error("Form submission failed");
        }

        const { encryptedData, authTag, aad, iv } = await response.json();

        const decryptedData = await decryptData(
          encryptedData,
          aesKey,
          iv,
          aad,
          authTag
        );

        console.log("Decrypted response data:", decryptedData);

        const parsedData = JSON.parse(decryptedData);
        if (parsedData.isRedirect) {
          await loadEncryptedContent(parsedData.url);
        } else {
          document.querySelector("#content").innerHTML = parsedData.data;

          // Execute any scripts in the new content
          const scripts = doc.querySelectorAll("script");
          scripts.forEach((script) => {
            const newScript = document.createElement("script");
            newScript.text = script.textContent;
            document.body.appendChild(newScript);
            document.body.removeChild(newScript);
          });
        }
      } catch (error) {
        console.error("Error deleting item:", error);
      }
    });
  });
</script>
