<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<h1>Encryption Performance Analysis</h1>

<% let progressInterval; %> <% if (dataAvailable) { %>
<canvas id="encryptionTimeChart" width="400" height="200"></canvas>
<% } else { %>
<p>
  No encryption performance data found for your account. Please run the
  encryption performance test first.
</p>
<% } %>

<div id="progressContainer" style="display: none">
  <p>Progress: <span id="progressText">0%</span></p>
  <progress id="progressBar" value="0" max="100"></progress>
</div>

<button id="startAnalysis">Start Analysis</button>

<script>
  document.getElementById("startAnalysis").addEventListener("click", () => {
    // Hardcoded default values
    const nodeMin = 65000;
    const nodeMax = 5460000;
    const nodeStep = 65000;
    const cppMin = 0;
    const cppMax = 130000;
    const cppStep = 5000;

    document.getElementById("progressContainer").style.display = "block";
    startProgressUpdate();

    fetch("/encrypt-performance-test", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        nodeMin: nodeMin,
        nodeMax: nodeMax,
        nodeStep: nodeStep,
        cppMin: cppMin,
        cppMax: cppMax,
        cppStep: cppStep,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.message === "finished") {
          alert("Encryption analysis is finished.");
          window.location.reload(); // Reload the page to show updated chart
        } else if (data.message === "error") {
          alert("Encryption analysis finished with errors.");
        } else if (data.message === "running") {
          alert(
            "Encryption analysis is already running. Please wait until it completes."
          );
        }
      })
      .catch((error) => {
        console.error("Error running encryption performance test:", error);
      });
  });

  function startProgressUpdate() {
    progressInterval = setInterval(() => {
      fetch("/encryption-progress")
        .then((response) => response.json())
        .then((data) => {
          if (data.running) {
            document.getElementById("progressBar").value = data.progress;
            document.getElementById(
              "progressText"
            ).textContent = `${data.progress}%`;
          } else {
            clearInterval(progressInterval);
            window.location.reload(); // Refresh the page to update the chart
          }
        })
        .catch((error) => {
          console.error("Error fetching progress:", error);
        });
    }, 1000); // Poll every 1 second
  }

  <% if (dataAvailable) { %>
    // Fetch the performance data passed from the server
    const performanceData = <%- JSON.stringify(performanceData) %>;

    // Prepare the data for Chart.js
    const labels = performanceData.map((item) => item.char_length);
    const nodejsTimes = performanceData.map(
      (item) => item.nodejs_encryption_time
    );
    const cppTimes = performanceData.map((item) => item.cpp_encryption_time);

    // Render the chart
    const ctx = document
      .getElementById("encryptionTimeChart")
      .getContext("2d");
    new Chart(ctx, {
      type: "line",
      data: {
        labels: labels,
        datasets: [
          {
            label: "Node.js Encryption Time (ms)",
            data: nodejsTimes,
            borderColor: "rgba(75, 192, 192, 1)",
            borderWidth: 1,
          },
          {
            label: "C++ Encryption Time (ms)",
            data: cppTimes,
            borderColor: "rgba(192, 75, 75, 1)",
            borderWidth: 1,
          },
        ],
      },
      options: {
        scales: {
          x: {
            title: {
              display: true,
              text: "Character Length",
            },
          },
          y: {
            beginAtZero: true,
            title: {
              display: true,
              text: "Encryption Time (ms)",
            },
          },
        },
      },
    });
  <% } %>
</script>
