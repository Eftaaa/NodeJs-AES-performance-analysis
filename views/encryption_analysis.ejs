<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<h1>Encryption Performance Analysis</h1>

<% let progressInterval; %>
  <% if (dataAvailable) { %>
    <canvas id="encryptionTimeChart" width="400" height="200"></canvas>
    <% } else { %>
      <p>
        No encryption performance data found for your account. Please run the
        encryption performance test first.
      </p>
      <% } %>

      <label for="nodeMin">Node.js Min Size:</label>
      <input type="number" id="nodeMin" name="nodeMin" value="50000" min="1" step="1" required>
  
      <label for="nodeMax">Node.js Max Size:</label>
      <input type="number" id="nodeMax" name="nodeMax" value="2000000" min="1" step="1" required>
  
      <label for="nodeStep">Node.js Step Size:</label>
      <input type="number" id="nodeStep" name="nodeStep" value="50000" min="1" step="1" required>
  
      <label for="cppMin">C++ Min Size:</label>
      <input type="number" id="cppMin" name="cppMin" value="50000" min="1" step="1" required>
  
      <label for="cppMax">C++ Max Size:</label>
      <input type="number" id="cppMax" name="cppMax" value="2000000" min="1" step="1" required>
  
      <label for="cppStep">C++ Step Size:</label>
      <input type="number" id="cppStep" name="cppStep" value="50000" min="1" step="1" required>

        <div id="progressContainer" style="display: none">
          <p>Progress: <span id="progressText">0%</span></p>
          <progress id="progressBar" value="0" max="100"></progress>
        </div>

        <button id="startAnalysis">Start Analysis</button>

        <script>
          if (typeof isProgressUpdating === "undefined") {
            var isProgressUpdating = false;
          }
          else {
            isProgressUpdating = false;
          }
          document.getElementById("startAnalysis").addEventListener("click", async () => {

                <% if (username == null) { %>

              alert("You must be logged in to perform this action.");
              loadEncryptedContent("/autentificare");
              return;
                      <% } %>

              const nodeMin = parseInt(document.getElementById('nodeMin').value, 10);
              const nodeMax = parseInt(document.getElementById('nodeMax').value, 10);
              const nodeStep = parseInt(document.getElementById('nodeStep').value, 10);
              const cppMin = parseInt(document.getElementById('cppMin').value, 10);
              const cppMax = parseInt(document.getElementById('cppMax').value, 10);
              const cppStep = parseInt(document.getElementById('cppStep').value, 10);
                  console.log("nodeMin",nodeMin)
                  console.log("nodeMax",nodeMax)
                  console.log("nodeStep",nodeStep)
                  console.log("cppMin",cppMin)
                  console.log("cppMax",cppMax)
                  console.log("cppStep",cppStep)

            document.getElementById("progressContainer").style.display = "block";

            // Check if progress update is already running
            if (!isProgressUpdating) {
              startProgressUpdate();
              isProgressUpdating = true; // Set the flag to true
            }

            try {
              const response = await fetch("/encrypt-performance-test", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  nodeMin: nodeMin,
                  nodeMax: nodeMax,
                  nodeStep: nodeStep,
                  cppMin: cppMin,
                  cppMax: cppMax,
                  cppStep: cppStep,
                }),
              });
             

              const data = await response.json();
              if (response.status === 401) {
                alert("You must be logged in to perform this action.");
              } else if (response.status === 400) {
                clearInterval(progressInterval); // Stop progress updates
                isProgressUpdating = false; // Reset the flag
                alert("Max character limit exceeded for Node.js or C++."); 
                return;
              }

              console.log("-------------Data-encrypt-performance-test----------");
              console.log(data);
              console.log("-------------Data-encrypt-performance-test----------");

              const { encryptedData, authTag, aad, iv } = data;

              // Decrypt the data
              const decryptedData = await decryptData(
                encryptedData,
                aesKey,
                iv,
                aad,
                authTag
              );

              // Convert the decrypted string into JSON
              const parsedData = JSON.parse(decryptedData);
              const realdata = JSON.parse(parsedData.data);


              if (realdata.message === "finished") {
                alert("Encryption analysis is finished.");
                loadEncryptedContent("/encryption_analysis"); // Reload the page to show updated chart
                clearInterval(progressInterval); // Stop progress updates
                isProgressUpdating = false; // Reset the flag
              } else if (realdata.message === "error") {
                alert("Encryption analysis finished with errors.");
                clearInterval(progressInterval); // Stop progress updates
                isProgressUpdating = false; // Reset the flag
              } else if (realdata.message === "running") {
                alert(
                  "Encryption analysis is already running. Please wait until it completes."
                );
              }
            } catch (error) {
              console.error("Error running encryption performance test:", error);
              clearInterval(progressInterval); // Stop progress updates
              isProgressUpdating = false; // Reset the flag
            }
          });

          function startProgressUpdate() {
            progressInterval = setInterval(async () => {
              try {
                const response = await fetch("/encryption-progress");
                const data = await response.json();

                const { encryptedData, authTag, aad, iv } = data;

                const decryptedData = await decryptData(
                  encryptedData,
                  aesKey,
                  iv,
                  aad,
                  authTag
                );

                // Convert the decrypted string into JSON
                const parsedData = JSON.parse(decryptedData);
                const realdata = JSON.parse(parsedData.data);

                console.log("-------------Data-encryption-progress----------");
                console.log(realdata);
                console.log("-------------Data-encryption-progress----------");

                if (realdata.running) {
                  document.getElementById("progressBar").value = realdata.progress;
                  document.getElementById(
                    "progressText"
                  ).textContent = `${realdata.progress}%`;
                } else {
                  clearInterval(progressInterval); // Stop progress updates when done
                  isProgressUpdating = false; // Reset the flag
                }
              } catch (error) {
                console.error("Error fetching progress:", error);
                clearInterval(progressInterval); // Stop progress updates in case of error
                isProgressUpdating = false; // Reset the flag
              }
            }, 1000); // Poll every 1 second
          }


                     <%
            console.log("Data available?:");

          console.log(dataAvailable);
          if (dataAvailable) { %>
              // Fetch the performance data passed from the server
              if (typeof performanceData === "undefined") {
              var performanceData = <%- JSON.stringify(performanceData) %>;
              // Prepare the data for Chart.js
              let labels = performanceData.map((item) => item.char_length);
              let nodejsTimes = performanceData.map(
                (item) => item.nodejs_encryption_time
              );
              let cppTimes = performanceData.map((item) => item.cpp_encryption_time);
              // Ensure Chart.js is loaded before rendering the chart
              let loadChartScript = new Promise((resolve, reject) => {
                let chartScript = document.createElement("script");
                chartScript.src = "https://cdn.jsdelivr.net/npm/chart.js";
                chartScript.onload = () => {
                  console.log("Chart.js loaded successfully");
                  resolve();
                };
                chartScript.onerror = () => {
                  reject(new Error("Failed to load Chart.js"));
                };
                document.body.appendChild(chartScript);
              });
              loadChartScript
                .then(() => {
                  console.log("Rendering the chart...");
                  renderChart(); // Call your chart rendering function here
                })
                .catch((error) => {
                  console.error(error.message);
                });
              function renderChart() {
                // Render the chart
                const ctx = document
                  .getElementById("encryptionTimeChart")
                  .getContext("2d");
                new Chart(ctx, {
                  type: "line",
                  data: {
                    labels: labels,
                    datasets: [
                      {
                        label: "Node.js Encryption Time (ms)",
                        data: nodejsTimes,
                        borderColor: "rgba(75, 192, 192, 1)",
                        borderWidth: 1,
                      },
                      {
                        label: "C++ Encryption Time (ms)",
                        data: cppTimes,
                        borderColor: "rgba(192, 75, 75, 1)",
                        borderWidth: 1,
                      },
                    ],
                  },
                  options: {
                    scales: {
                      x: {
                        title: {
                          display: true,
                          text: "Character Length",
                        },
                      },
                      y: {
                        beginAtZero: true,
                        title: {
                          display: true,
                          text: "Encryption Time (ms)",
                        },
                      },
                    },
                  },
                });
              }
            } else {
              // Update performanceData with new values
              performanceData = <%- JSON.stringify(performanceData) %>;
              // Prepare the data for Chart.js
              labels = performanceData.map((item) => item.char_length);
              nodejsTimes = performanceData.map(
                (item) => item.nodejs_encryption_time
              );
              cppTimes = performanceData.map((item) => item.cpp_encryption_time);
              // Ensure Chart.js is loaded before rendering the chart
              loadChartScript = new Promise((resolve, reject) => {
                chartScript = document.createElement("script");
                chartScript.src = "https://cdn.jsdelivr.net/npm/chart.js";
                chartScript.onload = () => {
                  console.log("Chart.js loaded successfully");
                  resolve();
                };
                chartScript.onerror = () => {
                  reject(new Error("Failed to load Chart.js"));
                };
                document.body.appendChild(chartScript);
              });
              loadChartScript
                .then(() => {
                  console.log("Rendering the chart...");
                  renderChart();
                })
                .catch((error) => {
                  console.error(error.message);
                });
              function renderChart() {
                // Render the chart
                const ctx = document
                  .getElementById("encryptionTimeChart")
                  .getContext("2d");
                new Chart(ctx, {
                  type: "line",
                  data: {
                    labels: labels,
                    datasets: [
                      {
                        label: "Node.js Encryption Time (ms)",
                        data: nodejsTimes,
                        borderColor: "rgba(75, 192, 192, 1)",
                        borderWidth: 1,
                      },
                      {
                        label: "C++ Encryption Time (ms)",
                        data: cppTimes,
                        borderColor: "rgba(192, 75, 75, 1)",
                        borderWidth: 1,
                      },
                    ],
                  },
                  options: {
                    scales: {
                      x: {
                        title: {
                          display: true,
                          text: "Character Length",
                        },
                      },
                      y: {
                        beginAtZero: true,
                        title: {
                          display: true,
                          text: "Encryption Time (ms)",
                        },
                      },
                    },
                  },
                });
              }


            }


              <% } %>
        </script>